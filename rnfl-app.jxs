import React, { useState, useEffect, useCallback, useRef } from "react";
import { Home as HomeIcon, CalendarDays, Users, ChevronLeft, Loader2, ShieldAlert, ImageOff } from "lucide-react";

/* ---------------------------------------------------------------
   RNFL — a scoreboard-inspired NFL companion
   Data: ESPN public site API (no key required), fetched client-side.
--------------------------------------------------------------- */

const BASE = "https://site.api.espn.com/apis/site/v2/sports/football/nfl";

const DIVISIONS = {
  "AFC East": ["BUF", "MIA", "NE", "NYJ"],
  "AFC North": ["BAL", "CIN", "CLE", "PIT"],
  "AFC South": ["HOU", "IND", "JAX", "TEN"],
  "AFC West": ["DEN", "KC", "LV", "LAC"],
  "NFC East": ["DAL", "NYG", "PHI", "WSH"],
  "NFC North": ["CHI", "DET", "GB", "MIN"],
  "NFC South": ["ATL", "CAR", "NO", "TB"],
  "NFC West": ["ARI", "LAR", "SF", "SEA"],
};

function fmtDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
}
function fmtTime(iso) {
  const d = new Date(iso);
  return d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
}

function Logo({ src, alt, size = 36 }) {
  const [broken, setBroken] = useState(false);
  if (!src || broken) {
    return (
      <div
        style={{ width: size, height: size }}
        className="flex items-center justify-center rounded-md bg-[#1c2129] text-[#4c5563] shrink-0"
      >
        <ShieldAlert size={size * 0.5} />
      </div>
    );
  }
  return (
    <img
      src={src}
      alt={alt}
      onError={() => setBroken(true)}
      style={{ width: size, height: size }}
      className="object-contain shrink-0"
    />
  );
}

function Headshot({ src, alt, name }) {
  const [broken, setBroken] = useState(false);
  const initials = (name || "?")
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
  if (!src || broken) {
    return (
      <div className="w-full aspect-square rounded-lg bg-[#1c2129] flex items-center justify-center text-[#5a6472] font-[Teko] text-3xl tracking-wide">
        {initials || <ImageOff size={22} />}
      </div>
    );
  }
  return (
    <img
      src={src}
      alt={alt}
      onError={() => setBroken(true)}
      className="w-full aspect-square rounded-lg object-cover bg-[#1c2129]"
    />
  );
}

function LoadingBlock({ label }) {
  return (
    <div className="flex flex-col items-center justify-center gap-3 py-16 text-[#6b7482]">
      <Loader2 size={28} className="animate-spin" />
      <span className="font-[Inter] text-sm tracking-wide">{label}</span>
    </div>
  );
}

function ErrorBlock({ label, onRetry }) {
  return (
    <div className="flex flex-col items-center justify-center gap-3 py-16 text-[#6b7482] px-8 text-center">
      <ShieldAlert size={28} />
      <span className="font-[Inter] text-sm">{label}</span>
      {onRetry && (
        <button
          onClick={onRetry}
          className="mt-1 px-4 py-1.5 rounded-full border border-[#2a313c] text-[#e8ecf1] text-xs font-[Inter] font-medium tracking-wide hover:border-[#F2A93B] transition-colors"
        >
          Try again
        </button>
      )}
    </div>
  );
}

/* ---------------------------- HOME ---------------------------- */

function Home({ onJumpToGames, onJumpToTeams }) {
  const [state, setState] = useState({ status: "loading", week: null, events: [] });

  const load = useCallback(() => {
    setState({ status: "loading", week: null, events: [] });
    fetch(`${BASE}/scoreboard`)
      .then((r) => r.json())
      .then((data) => {
        setState({
          status: "ok",
          week: data?.week?.number ?? null,
          events: data?.events ?? [],
        });
      })
      .catch(() => setState({ status: "error", week: null, events: [] }));
  }, []);

  useEffect(() => load(), [load]);

  const live = state.events.filter((e) => e.status?.type?.state === "in");
  const today = new Date().toLocaleDateString(undefined, {
    weekday: "long",
    month: "long",
    day: "numeric",
  });

  return (
    <div className="flex flex-col h-full">
      {live.length > 0 && (
        <div className="overflow-hidden border-b border-[#1e242c] bg-[#12151b] py-2">
          <div className="marquee flex gap-8 whitespace-nowrap font-[JetBrains_Mono] text-xs text-[#F2A93B]">
            {[...live, ...live].map((e, i) => {
              const c = e.competitions?.[0]?.competitors ?? [];
              const away = c.find((x) => x.homeAway === "away");
              const home = c.find((x) => x.homeAway === "home");
              return (
                <span key={i} className="flex items-center gap-2">
                  <span className="w-1.5 h-1.5 rounded-full bg-[#FF3D2E] animate-pulse" />
                  {away?.team?.abbreviation} {away?.score}–{home?.score} {home?.team?.abbreviation}
                </span>
              );
            })}
          </div>
        </div>
      )}

      <div className="px-5 pt-6 pb-4">
        <div className="text-[#6b7482] font-[Inter] text-xs uppercase tracking-[0.2em] mb-1">{today}</div>
        <h2 className="font-[Teko] text-4xl text-[#e8ecf1] leading-none">
          Week {state.week ?? "—"}
        </h2>
      </div>

      <div className="flex-1 overflow-y-auto px-5 pb-6">
        {state.status === "loading" && <LoadingBlock label="Loading today's slate…" />}
        {state.status === "error" && <ErrorBlock label="Couldn't reach the scoreboard." onRetry={load} />}
        {state.status === "ok" && state.events.length === 0 && (
          <div className="text-[#6b7482] font-[Inter] text-sm py-10 text-center">
            No games logged for this week yet.
          </div>
        )}
        {state.status === "ok" &&
          state.events.slice(0, 6).map((e) => {
            const c = e.competitions?.[0]?.competitors ?? [];
            const away = c.find((x) => x.homeAway === "away");
            const home = c.find((x) => x.homeAway === "home");
            const isLive = e.status?.type?.state === "in";
            const isFinal = e.status?.type?.completed;
            return (
              <div
                key={e.id}
                className="flex items-center justify-between py-3 border-b border-[#1a1f26] last:border-0"
              >
                <div className="flex items-center gap-2 flex-1 min-w-0">
                  <Logo src={away?.team?.logo} alt={away?.team?.abbreviation} size={26} />
                  <span className="font-[Inter] text-sm text-[#c3c9d2] truncate">{away?.team?.abbreviation}</span>
                  <span className="font-[Teko] text-lg text-[#e8ecf1] w-6 text-center">{away?.score ?? 0}</span>
                </div>
                <div className="flex flex-col items-center px-3">
                  {isLive ? (
                    <span className="text-[10px] font-[Inter] font-semibold text-[#FF3D2E] tracking-widest">LIVE</span>
                  ) : isFinal ? (
                    <span className="text-[10px] font-[Inter] text-[#6b7482] tracking-widest">FINAL</span>
                  ) : (
                    <span className="text-[10px] font-[Inter] text-[#6b7482] tracking-widest">{fmtTime(e.date)}</span>
                  )}
                </div>
                <div className="flex items-center gap-2 flex-1 min-w-0 justify-end">
                  <span className="font-[Teko] text-lg text-[#e8ecf1] w-6 text-center">{home?.score ?? 0}</span>
                  <span className="font-[Inter] text-sm text-[#c3c9d2] truncate">{home?.team?.abbreviation}</span>
                  <Logo src={home?.team?.logo} alt={home?.team?.abbreviation} size={26} />
                </div>
              </div>
            );
          })}
      </div>

      <div className="px-5 pb-6 flex gap-3">
        <button
          onClick={onJumpToGames}
          className="flex-1 py-3 rounded-xl bg-[#1c2129] text-[#e8ecf1] font-[Inter] text-sm font-medium tracking-wide active:scale-[0.98] transition-transform"
        >
          Full schedule
        </button>
        <button
          onClick={onJumpToTeams}
          className="flex-1 py-3 rounded-xl bg-[#1c2129] text-[#e8ecf1] font-[Inter] text-sm font-medium tracking-wide active:scale-[0.98] transition-transform"
        >
          Teams
        </button>
      </div>
    </div>
  );
}

/* ---------------------------- GAMES ---------------------------- */

function GameDetail({ game, onBack }) {
  const c = game.competitions?.[0]?.competitors ?? [];
  const away = c.find((x) => x.homeAway === "away");
  const home = c.find((x) => x.homeAway === "home");
  const isLive = game.status?.type?.state === "in";
  const isFinal = game.status?.type?.completed;
  const notStarted = game.status?.type?.state === "pre";

  return (
    <div className="flex flex-col h-full">
      <div className="flex items-center gap-2 px-4 pt-5 pb-3">
        <button onClick={onBack} className="p-1 -ml-1 text-[#c3c9d2]">
          <ChevronLeft size={22} />
        </button>
        <span className="font-[Inter] text-xs uppercase tracking-[0.2em] text-[#6b7482]">
          {fmtDate(game.date)}
        </span>
      </div>

      <div className="flex-1 flex flex-col items-center justify-center px-6 -mt-10">
        <div className="w-full flex items-center justify-between mb-2">
          <div className="flex flex-col items-center gap-3 flex-1">
            <Logo src={away?.team?.logo} alt={away?.team?.displayName} size={64} />
            <span className="font-[Inter] text-sm text-[#c3c9d2] text-center">{away?.team?.displayName}</span>
          </div>
          <div className="flex flex-col items-center px-2">
            <div className="font-[Teko] text-6xl text-[#e8ecf1] leading-none flex items-center gap-3">
              <span>{notStarted ? 0 : away?.score ?? 0}</span>
              <span className="text-[#4c5563] text-4xl">–</span>
              <span>{notStarted ? 0 : home?.score ?? 0}</span>
            </div>
            <span
              className={`mt-2 text-[11px] font-[Inter] font-semibold tracking-widest ${
                isLive ? "text-[#FF3D2E]" : isFinal ? "text-[#6b7482]" : "text-[#F2A93B]"
              }`}
            >
              {isLive
                ? `LIVE • ${game.status?.type?.shortDetail ?? ""}`
                : isFinal
                ? "FINAL"
                : fmtTime(game.date)}
            </span>
          </div>
          <div className="flex flex-col items-center gap-3 flex-1">
            <Logo src={home?.team?.logo} alt={home?.team?.displayName} size={64} />
            <span className="font-[Inter] text-sm text-[#c3c9d2] text-center">{home?.team?.displayName}</span>
          </div>
        </div>
      </div>

      <div className="px-6 pb-8 text-center">
        <span className="font-[Inter] text-xs text-[#4c5563] tracking-wide">
          {game.competitions?.[0]?.venue?.fullName ?? ""}
        </span>
      </div>
    </div>
  );
}

function Games() {
  const [week, setWeek] = useState(1);
  const [defaultWeekSet, setDefaultWeekSet] = useState(false);
  const cache = useRef({});
  const [status, setStatus] = useState("loading");
  const [events, setEvents] = useState([]);
  const [selected, setSelected] = useState(null);
  const year = new Date().getFullYear();

  // find current week once, to preselect
  useEffect(() => {
    if (defaultWeekSet) return;
    fetch(`${BASE}/scoreboard`)
      .then((r) => r.json())
      .then((d) => {
        setWeek(d?.week?.number ?? 1);
        setDefaultWeekSet(true);
      })
      .catch(() => setDefaultWeekSet(true));
  }, [defaultWeekSet]);

  const load = useCallback(
    (w) => {
      if (cache.current[w]) {
        setEvents(cache.current[w]);
        setStatus("ok");
        return;
      }
      setStatus("loading");
      fetch(`${BASE}/scoreboard?week=${w}&seasontype=2&year=${year}`)
        .then((r) => r.json())
        .then((d) => {
          const ev = d?.events ?? [];
          cache.current[w] = ev;
          setEvents(ev);
          setStatus("ok");
        })
        .catch(() => setStatus("error"));
    },
    [year]
  );

  useEffect(() => {
    if (defaultWeekSet) load(week);
  }, [week, defaultWeekSet, load]);

  if (selected) return <GameDetail game={selected} onBack={() => setSelected(null)} />;

  return (
    <div className="flex flex-col h-full">
      <div className="px-5 pt-6 pb-3">
        <h2 className="font-[Teko] text-4xl text-[#e8ecf1] leading-none mb-4">Schedule</h2>
        <div className="flex gap-2 overflow-x-auto pb-1 -mx-5 px-5 no-scrollbar">
          {Array.from({ length: 18 }, (_, i) => i + 1).map((w) => (
            <button
              key={w}
              onClick={() => setWeek(w)}
              className={`shrink-0 px-3.5 py-1.5 rounded-full font-[Inter] text-sm font-medium transition-colors ${
                w === week
                  ? "bg-[#F2A93B] text-[#12151b]"
                  : "bg-[#1c2129] text-[#8b93a1] hover:text-[#c3c9d2]"
              }`}
            >
              {w}
            </button>
          ))}
        </div>
      </div>

      <div className="flex-1 overflow-y-auto px-5 pb-6">
        {status === "loading" && <LoadingBlock label={`Loading week ${week}…`} />}
        {status === "error" && <ErrorBlock label="Couldn't load this week's games." onRetry={() => load(week)} />}
        {status === "ok" && events.length === 0 && (
          <div className="text-[#6b7482] font-[Inter] text-sm py-10 text-center">No games scheduled.</div>
        )}
        {status === "ok" &&
          (() => {
            let lastDate = "";
            return events.map((e) => {
              const c = e.competitions?.[0]?.competitors ?? [];
              const away = c.find((x) => x.homeAway === "away");
              const home = c.find((x) => x.homeAway === "home");
              const isLive = e.status?.type?.state === "in";
              const isFinal = e.status?.type?.completed;
              const day = fmtDate(e.date);
              const showHeader = day !== lastDate;
              lastDate = day;
              return (
                <React.Fragment key={e.id}>
                  {showHeader && (
                    <div className="font-[Inter] text-[11px] uppercase tracking-[0.2em] text-[#4c5563] pt-4 pb-2 first:pt-0">
                      {day}
                    </div>
                  )}
                  <button
                    onClick={() => setSelected(e)}
                    className="w-full flex items-center justify-between py-3 border-b border-[#1a1f26] active:opacity-70 transition-opacity text-left"
                  >
                    <div className="flex items-center gap-2 flex-1 min-w-0">
                      <Logo src={away?.team?.logo} alt={away?.team?.abbreviation} size={28} />
                      <span className="font-[Inter] text-sm text-[#c3c9d2] truncate">{away?.team?.shortDisplayName}</span>
                    </div>
                    <div className="flex flex-col items-center px-3 shrink-0">
                      {isLive ? (
                        <span className="font-[Teko] text-lg text-[#FF3D2E]">
                          {away?.score}–{home?.score}
                        </span>
                      ) : isFinal ? (
                        <span className="font-[Teko] text-lg text-[#e8ecf1]">
                          {away?.score}–{home?.score}
                        </span>
                      ) : (
                        <span className="font-[JetBrains_Mono] text-[11px] text-[#6b7482]">{fmtTime(e.date)}</span>
                      )}
                    </div>
                    <div className="flex items-center gap-2 flex-1 min-w-0 justify-end">
                      <span className="font-[Inter] text-sm text-[#c3c9d2] truncate text-right">
                        {home?.team?.shortDisplayName}
                      </span>
                      <Logo src={home?.team?.logo} alt={home?.team?.abbreviation} size={28} />
                    </div>
                  </button>
                </React.Fragment>
              );
            });
          })()}
      </div>
    </div>
  );
}

/* ---------------------------- TEAMS ---------------------------- */

function Roster({ team, onBack }) {
  const [status, setStatus] = useState("loading");
  const [groups, setGroups] = useState([]);

  const load = useCallback(() => {
    setStatus("loading");
    fetch(`${BASE}/teams/${team.id}/roster`)
      .then((r) => r.json())
      .then((d) => {
        setGroups(d?.athletes ?? []);
        setStatus("ok");
      })
      .catch(() => setStatus("error"));
  }, [team.id]);

  useEffect(() => load(), [load]);

  return (
    <div className="flex flex-col h-full">
      <div className="flex items-center gap-3 px-4 pt-5 pb-4">
        <button onClick={onBack} className="p-1 -ml-1 text-[#c3c9d2]">
          <ChevronLeft size={22} />
        </button>
        <Logo src={team.logo} alt={team.displayName} size={30} />
        <h2 className="font-[Teko] text-3xl text-[#e8ecf1] leading-none">{team.displayName}</h2>
      </div>

      <div className="flex-1 overflow-y-auto px-5 pb-8">
        {status === "loading" && <LoadingBlock label="Loading roster…" />}
        {status === "error" && <ErrorBlock label="Couldn't load this roster." onRetry={load} />}
        {status === "ok" &&
          groups.map((g) => (
            <div key={g.position} className="mb-6">
              <div className="font-[Inter] text-[11px] uppercase tracking-[0.2em] text-[#4c5563] mb-3">
                {g.position}
              </div>
              <div className="grid grid-cols-3 gap-3">
                {(g.items ?? []).map((p) => (
                  <div key={p.id} className="flex flex-col gap-1.5">
                    <Headshot src={p.headshot?.href} alt={p.fullName} name={p.fullName} />
                    <span className="font-[Inter] text-xs text-[#e8ecf1] leading-tight truncate">{p.fullName}</span>
                    <span className="font-[JetBrains_Mono] text-[10px] text-[#6b7482]">
                      {p.jersey ? `#${p.jersey}` : "—"} {p.position?.abbreviation ?? ""}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
      </div>
    </div>
  );
}

function Teams() {
  const [status, setStatus] = useState("loading");
  const [teams, setTeams] = useState([]);
  const [selected, setSelected] = useState(null);

  const load = useCallback(() => {
    setStatus("loading");
    fetch(`${BASE}/teams?limit=32`)
      .then((r) => r.json())
      .then((d) => {
        const list = (d?.sports?.[0]?.leagues?.[0]?.teams ?? []).map((t) => t.team);
        setTeams(list);
        setStatus("ok");
        // lazily fetch records, non-blocking
        list.forEach((t) => {
          fetch(`${BASE}/teams/${t.id}`)
            .then((r) => r.json())
            .then((d2) => {
              const summary = d2?.team?.record?.items?.[0]?.summary;
              if (summary) {
                setTeams((prev) =>
                  prev.map((pt) => (pt.id === t.id ? { ...pt, _record: summary } : pt))
                );
              }
            })
            .catch(() => {});
        });
      })
      .catch(() => setStatus("error"));
  }, []);

  useEffect(() => load(), [load]);

  if (selected) return <Roster team={selected} onBack={() => setSelected(null)} />;

  const byAbbr = Object.fromEntries(teams.map((t) => [t.abbreviation, t]));

  return (
    <div className="flex flex-col h-full">
      <div className="px-5 pt-6 pb-3">
        <h2 className="font-[Teko] text-4xl text-[#e8ecf1] leading-none">Teams</h2>
      </div>
      <div className="flex-1 overflow-y-auto px-5 pb-6">
        {status === "loading" && <LoadingBlock label="Loading teams…" />}
        {status === "error" && <ErrorBlock label="Couldn't load the league." onRetry={load} />}
        {status === "ok" &&
          Object.entries(DIVISIONS).map(([div, abbrs]) => (
            <div key={div} className="mb-5">
              <div className="font-[Inter] text-[11px] uppercase tracking-[0.2em] text-[#4c5563] mb-2">{div}</div>
              <div className="rounded-xl overflow-hidden bg-[#14181d]">
                {abbrs.map((ab, i) => {
                  const t = byAbbr[ab];
                  if (!t) return null;
                  return (
                    <button
                      key={ab}
                      onClick={() => setSelected(t)}
                      className={`w-full flex items-center gap-3 px-3.5 py-3 text-left active:bg-[#1c2129] transition-colors ${
                        i !== abbrs.length - 1 ? "border-b border-[#1a1f26]" : ""
                      }`}
                    >
                      <Logo src={t.logos?.[0]?.href} alt={t.displayName} size={30} />
                      <span className="font-[Inter] text-sm text-[#e8ecf1] flex-1 truncate">{t.displayName}</span>
                      <span className="font-[JetBrains_Mono] text-xs text-[#6b7482]">{t._record ?? "—"}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
      </div>
    </div>
  );
}

/* ---------------------------- APP SHELL ---------------------------- */

export default function App() {
  const [tab, setTab] = useState("home");

  return (
    <div className="w-full h-[100dvh] max-w-md mx-auto bg-[#0d0f13] flex flex-col overflow-hidden relative">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .marquee { animation: scroll-left 18s linear infinite; }
        @keyframes scroll-left {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }
        @media (prefers-reduced-motion: reduce) {
          .marquee { animation: none; }
        }
      `}</style>

      {/* top bar */}
      <div className="flex items-center justify-between px-5 pt-5 pb-2 border-b border-[#1a1f26]">
        <div className="flex items-center gap-2">
          <span className="w-2 h-2 rounded-full bg-[#FF3D2E]" />
          <h1 className="font-[Teko] text-2xl tracking-[0.08em] text-[#e8ecf1]">RNFL</h1>
        </div>
        <span className="font-[JetBrains_Mono] text-[10px] text-[#4c5563] uppercase tracking-widest">
          {new Date().getFullYear()} Season
        </span>
      </div>

      {/* content */}
      <div className="flex-1 min-h-0">
        {tab === "home" && <Home onJumpToGames={() => setTab("games")} onJumpToTeams={() => setTab("teams")} />}
        {tab === "games" && <Games />}
        {tab === "teams" && <Teams />}
      </div>

      {/* bottom nav */}
      <div className="flex items-stretch border-t border-[#1a1f26] bg-[#0d0f13]">
        {[
          { key: "home", label: "Home", Icon: HomeIcon },
          { key: "games", label: "Games", Icon: CalendarDays },
          { key: "teams", label: "Teams/Players", Icon: Users },
        ].map(({ key, label, Icon }) => (
          <button
            key={key}
            onClick={() => setTab(key)}
            className="flex-1 flex flex-col items-center gap-1 py-2.5"
          >
            <Icon size={20} color={tab === key ? "#F2A93B" : "#5a6472"} strokeWidth={tab === key ? 2.4 : 2} />
            <span
              className={`font-[Inter] text-[10px] tracking-wide ${
                tab === key ? "text-[#F2A93B] font-semibold" : "text-[#5a6472]"
              }`}
            >
              {label}
            </span>
          </button>
        ))}
      </div>
    </div>
  );
}
